# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Installers / binaries must never live in public/ — they would be served to
# visitors AND GitHub rejects any single file over 100 MB.
*.exe
*.msi
*.zip
*.dmg

# Full-resolution source artwork (5–8 MB each). The web-ready, optimised
# derivatives in public/banners and public/products are what the site loads;
# keep the originals locally rather than bloating the repo.
/public/images/banarrr.png
/public/images/bnar.png
/public/images/bner22.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/
